{
  "name": "next16-ui-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for @atanael/ui, its Next.js documentation app and Vite playground.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @atanael/docs",
    "dev:docs": "npm run dev -w @atanael/docs",
    "dev:playground": "npm run dev -w @atanael/playground",
    "build": "npm run build -w @atanael/ui && npm run build -w @atanael/docs",
    "build:ui": "npm run build -w @atanael/ui",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit -w @atanael/ui",
    "test:e2e": "npm run test:e2e -w @atanael/docs",
    "pack:verify": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
